---
// Left-to-right process diagram (stacks vertically on narrow screens).
interface Step {
  title: string;
  text?: string;
  tag?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="pipeline" style={`--n: ${steps.length}`}>
  {
    steps.map((s, i) => (
      <li class="pipeline__step">
        <span class="pipeline__index">{s.tag ?? i + 1}</span>
        <strong class="pipeline__title">{s.title}</strong>
        {s.text && <span class="pipeline__text">{s.text}</span>}
      </li>
    ))
  }
</ol>

<style>
  .pipeline {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 22px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.4;
  }

  .pipeline__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 12px 14px;
    margin: 0;
    border: 1px solid var(--border-color);
    border-top: 3px solid var(--primary);
    border-radius: 6px;
    background: var(--surface-bg);
  }

  .pipeline__step:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -17px;
    top: 50%;
    width: 10px;
    height: 10px;
    border-top: 2px solid var(--faint-color);
    border-right: 2px solid var(--faint-color);
    transform: translateY(-50%) rotate(45deg);
  }

  .pipeline__index {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .pipeline__title {
    color: var(--heading-color);
    font-size: 0.95rem;
  }

  .pipeline__text {
    color: var(--muted-color);
  }

  @media (max-width: 640px) {
    .pipeline {
      grid-template-columns: 1fr;
    }

    .pipeline__step:not(:last-child)::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -17px;
      transform: translateX(-50%) rotate(135deg);
    }
  }
</style>
