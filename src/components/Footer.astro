---
import Icon from './Icon.astro';
import { links, profile } from '../data/cv.js';

const icons = [
  { name: 'github', label: 'GitHub', url: links.github },
  { name: 'huggingface', label: 'Hugging Face', url: links.huggingface },
  { name: 'scholar', label: 'Google Scholar', url: links.scholar },
  { name: 'orcid', label: 'ORCID', url: links.orcid },
  { name: 'linkedin', label: 'LinkedIn', url: links.linkedin },
  { name: 'email', label: 'Email', url: `mailto:${profile.email}` },
] as const;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {new Date().getFullYear()} {profile.name}</p>
    <ul class="footer-links">
      <li><a href="/contact/">Contact</a></li>
      {
        icons.map((i) => (
          <li>
            <a
              class="footer-icon"
              href={i.url}
              aria-label={i.label}
              title={i.label}
              {...(i.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={i.name} size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    font-size: 0.78rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  p {
    margin: 0;
    color: var(--muted-color);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: #fff;
  }

  .footer-icon {
    display: grid;
    place-items: center;
  }
</style>
