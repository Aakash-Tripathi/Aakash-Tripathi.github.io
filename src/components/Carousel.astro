---
// Full-bleed, scroll-snapping image strip that loops forever. The slides are rendered
// three times; after scrolling settles on a copy, the track jumps to the same slide in
// the middle copy, so there is always something to the left and right.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  image: ImageMetadata;
  alt: string;
  caption: string;
  href?: string;
  fit?: 'cover' | 'contain';
  bg?: string;
}

interface Props {
  slides: Slide[];
  label: string;
}

const { slides, label } = Astro.props;
const copies = [0, 1, 2].flatMap((copy) => slides.map((s, i) => ({ ...s, i, clone: copy !== 1 })));
---

<section class="carousel" aria-roledescription="carousel" aria-label={label}>
  <div class="carousel__track" tabindex="0">
    {
      copies.map((s) => (
        <figure
          class="carousel__slide"
          aria-roledescription={s.clone ? undefined : 'slide'}
          aria-label={s.clone ? undefined : `${s.i + 1} of ${slides.length}`}
          aria-hidden={s.clone ? 'true' : undefined}
          data-clone={s.clone ? '' : undefined}
        >
          <div class:list={['carousel__frame', `carousel__frame--${s.fit ?? 'contain'}`]} style={s.bg ? `background: ${s.bg}` : undefined}>
            <Image
              src={s.image}
              alt={s.clone ? '' : s.alt}
              widths={[640, 960, 1400]}
              sizes="(min-width: 1100px) 1000px, 86vw"
              loading={!s.clone && s.i < 2 ? 'eager' : 'lazy'}
            />
          </div>
          <figcaption>
            {s.href ? (
              <a href={s.href} tabindex={s.clone ? -1 : undefined}>
                {s.caption}
              </a>
            ) : (
              s.caption
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <button class="carousel__arrow carousel__arrow--prev" type="button" data-dir="-1" aria-label="Previous slide">&larr;</button>
  <button class="carousel__arrow carousel__arrow--next" type="button" data-dir="1" aria-label="Next slide">&rarr;</button>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.carousel__track')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.carousel__slide')];
    const n = slides.length / 3;
    root.dataset.js = '';

    // scrollLeft that centres slide i
    const centre = (i: number) => slides[i].offsetLeft + slides[i].offsetWidth / 2 - track.clientWidth / 2;
    const nearest = () => {
      let best = 0;
      for (let i = 1; i < slides.length; i++) {
        if (Math.abs(centre(i) - track.scrollLeft) < Math.abs(centre(best) - track.scrollLeft)) best = i;
      }
      return best;
    };
    const jump = (i: number) => track.scrollTo({ left: centre(i), behavior: 'instant' });
    const markActive = () => {
      const a = nearest();
      slides.forEach((s, i) => s.toggleAttribute('data-active', i === a));
    };
    // Once scrolling stops on a copy, move to the same slide in the middle copy.
    const recentre = () => {
      const a = nearest();
      if (a < n) jump(a + n);
      else if (a >= 2 * n) jump(a - n);
      markActive();
    };

    let settle: number | undefined;
    track.addEventListener(
      'scroll',
      () => {
        markActive();
        clearTimeout(settle);
        settle = window.setTimeout(recentre, 140);
      },
      { passive: true },
    );
    track.addEventListener('scrollend', recentre);
    addEventListener('resize', () => jump(n + (nearest() % n)));
    // Start every arrow move from the middle copy, so the target always exists.
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const a = n + (nearest() % n);
        jump(a);
        track.scrollTo({ left: centre(a + Number(btn.dataset.dir)) });
      }),
    );

    jump(n);
    markActive();
  });
</script>

<style>
  .carousel {
    --slide-w: min(78vw, 1000px);
    --frame-h: clamp(240px, 46vw, 560px);
    position: relative;
    padding-bottom: 64px;
  }

  .carousel__track {
    position: relative;
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: calc((100vw - var(--slide-w)) / 2);
    scrollbar-width: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel__track {
      scroll-behavior: smooth;
    }
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 var(--slide-w);
    margin: 0;
    scroll-snap-align: center;
  }

  /* Without JS the copies would just repeat, so show the originals only. */
  .carousel:not([data-js]) .carousel__slide[data-clone] {
    display: none;
  }

  .carousel__frame {
    height: var(--frame-h);
    overflow: hidden;
    background: #fff;
  }

  .carousel__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .carousel__frame--contain {
    padding: clamp(10px, 2vw, 28px);
  }

  .carousel__frame--contain :global(img) {
    object-fit: contain;
  }

  .carousel__frame--cover {
    background: #111;
  }

  .carousel__frame--cover :global(img) {
    object-fit: cover;
  }

  figcaption {
    transition: opacity 0.2s;
    padding: 18px 16px 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-color);
  }

  .carousel[data-js] figcaption {
    opacity: 0;
  }

  .carousel[data-js] .carousel__slide[data-active] figcaption,
  .carousel[data-js] .carousel__slide:focus-within figcaption {
    opacity: 1;
  }

  figcaption a {
    text-decoration: none;
  }

  figcaption a:hover {
    text-decoration: underline;
  }

  /* Arrows sit over the left and right edges of the centred slide. */
  .carousel__arrow {
    position: absolute;
    top: calc(var(--frame-h) / 2);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #000;
    font-size: 1.2rem;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
    transition: background-color 0.15s, transform 0.15s;
  }

  .carousel__arrow:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.06);
  }

  .carousel__arrow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .carousel__arrow--prev {
    left: max(16px, calc((100vw - var(--slide-w)) / 2 - 24px));
  }

  .carousel__arrow--next {
    right: max(16px, calc((100vw - var(--slide-w)) / 2 - 24px));
  }

  .carousel:not([data-js]) .carousel__arrow {
    display: none;
  }
</style>
