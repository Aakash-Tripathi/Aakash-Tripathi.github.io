---
// Full-bleed, scroll-snapping image strip with arrow buttons and a caption per slide.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  image: ImageMetadata;
  alt: string;
  caption: string;
  href?: string;
  fit?: 'cover' | 'contain';
}

interface Props {
  slides: Slide[];
  label: string;
}

const { slides, label } = Astro.props;
---

<section class="carousel" aria-roledescription="carousel" aria-label={label}>
  <div class="carousel__track" tabindex="0">
    {
      slides.map((s, i) => (
        <figure class="carousel__slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
          <div class:list={['carousel__frame', `carousel__frame--${s.fit ?? 'contain'}`]}>
            <Image src={s.image} alt={s.alt} widths={[640, 960, 1400]} sizes="(min-width: 1100px) 1000px, 86vw" loading={i < 2 ? 'eager' : 'lazy'} />
          </div>
          <figcaption>{s.href ? <a href={s.href}>{s.caption}</a> : s.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  <div class="carousel__controls">
    <button type="button" data-dir="-1" aria-label="Previous slide">&larr;</button>
    <button type="button" data-dir="1" aria-label="Next slide">&rarr;</button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.carousel__track');
    root.dataset.js = '';
    // Show the caption of the slide nearest the centre only.
    const slides = [...root.querySelectorAll<HTMLElement>('.carousel__slide')];
    const markActive = () => {
      if (!track) return;
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = slides[0];
      for (const s of slides) if (Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid) < Math.abs(best.offsetLeft + best.offsetWidth / 2 - mid)) best = s;
      slides.forEach((s) => s.toggleAttribute('data-active', s === best));
    };
    track?.addEventListener('scroll', markActive, { passive: true });
    markActive();
    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const slide = track?.querySelector<HTMLElement>('.carousel__slide');
        if (!track || !slide) return;
        const step = slide.offsetWidth * Number(btn.dataset.dir);
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        const atStart = track.scrollLeft <= 4;
        if (step > 0 && atEnd) track.scrollTo({ left: 0 });
        else if (step < 0 && atStart) track.scrollTo({ left: track.scrollWidth });
        else track.scrollBy({ left: step });
      }),
    );
  });
</script>

<style>
  .carousel {
    --slide-w: min(78vw, 1000px);
    padding-bottom: 72px;
  }

  .carousel__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: calc((100vw - var(--slide-w)) / 2);
    scrollbar-width: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel__track {
      scroll-behavior: smooth;
    }
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__slide {
    flex: 0 0 var(--slide-w);
    margin: 0;
    scroll-snap-align: center;
  }

  .carousel__frame {
    height: clamp(240px, 46vw, 560px);
    overflow: hidden;
    background: #fff;
  }

  .carousel__frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .carousel__frame--contain {
    padding: clamp(10px, 2vw, 28px);
  }

  .carousel__frame--contain :global(img) {
    object-fit: contain;
  }

  .carousel__frame--cover {
    background: #111;
  }

  .carousel__frame--cover :global(img) {
    object-fit: cover;
  }

  figcaption {
    transition: opacity 0.2s;
    padding: 18px 16px 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-color);
  }

  .carousel[data-js] figcaption {
    opacity: 0;
  }

  .carousel[data-js] .carousel__slide[data-active] figcaption,
  .carousel[data-js] .carousel__slide:focus-within figcaption {
    opacity: 1;
  }

  .carousel:not([data-js]) .carousel__controls {
    display: none;
  }

  figcaption a {
    text-decoration: none;
  }

  figcaption a:hover {
    text-decoration: underline;
  }

  .carousel__controls {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
  }

  .carousel__controls button {
    width: 44px;
    height: 44px;
    border: 0;
    background: #c9c9c9;
    color: #000;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .carousel__controls button:hover {
    background: #fff;
  }
</style>
