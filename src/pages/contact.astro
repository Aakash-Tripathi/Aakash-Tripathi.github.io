---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { profile, links } from '../data/cv.js';

const profiles = [
  { label: 'Google Scholar', url: links.scholar },
  { label: 'ORCID', url: links.orcid, detail: '0000-0001-7231-0487' },
  { label: 'GitHub', url: links.github, detail: 'Aakash-Tripathi' },
  { label: 'Hugging Face', url: links.huggingface, detail: 'Aakash-Tripathi' },
  { label: 'LinkedIn', url: links.linkedin },
  { label: 'ResearchGate', url: links.researchgate },
  { label: 'Lab GitHub', url: links.labGithub, detail: 'lab-rasool' },
  { label: 'Lab Hugging Face', url: links.labHuggingface, detail: 'Lab-Rasool' },
];
---

<Layout
  title="Contact | Aakash Tripathi"
  description="Contact Aakash Tripathi, PhD, at Moffitt Cancer Center: email, phone, and research profiles for collaboration on multimodal AI and clinical LLMs in oncology."
>
  <PageIntro title="Get in touch">
    <p>For collaborations, talks, or questions about the code and datasets, email is the fastest way to reach me.</p>
  </PageIntro>

  <div class="container"><div class="contact">
    <section class="card">
      <h2>Email & phone</h2>
      <p><a class="big" href={`mailto:${profile.email}`}>{profile.email}</a></p>
      <p><a href={`mailto:${profile.personalEmail}`}>{profile.personalEmail}</a></p>
      <p class="muted">{profile.phone}</p>
    </section>

    <section class="card">
      <h2>Affiliation</h2>
      <p>
        {profile.role}, {profile.focus}<br />
        <a href={profile.organizationUrl} target="_blank" rel="noopener noreferrer">{profile.organization}</a><br />
        <span class="muted">{profile.location}</span>
      </p>
      <p><a href={links.lab} target="_blank" rel="noopener noreferrer">Rasool Lab</a></p>
    </section>

    <section class="card card--wide">
      <h2>Profiles</h2>
      <ul class="profiles">
        {
          profiles.map((p) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                {p.label}
              </a>
              {p.detail && <span class="muted"> · {p.detail}</span>}
            </li>
          ))
        }
      </ul>
    </section>
  </div></div>
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    padding-top: 72px;
    padding-bottom: 96px;
    max-width: 920px;
  }

  .card {
    padding: 22px 24px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
  }

  .card--wide {
    grid-column: 1 / -1;
  }

  .card h2 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--faint-color);
    margin-bottom: 12px;
  }

  .card p {
    margin: 0 0 6px;
  }

  .big {
    font-size: 1.15rem;
    font-weight: 700;
    word-break: break-word;
  }

  .profiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 8px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .profiles a {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
