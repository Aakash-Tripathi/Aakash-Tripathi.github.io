---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { talks, teaching } from '../data/cv.js';
import { asset, cover } from '../lib/images.js';
import { isMe, getProjects, coverCredit } from '../lib/projects.js';

const posts = Object.fromEntries((await getProjects("research")).map((p) => [p.slug, p]));

// "October 30, 2025" -> { month: 'OCT', year: '2025' }; "2026" -> { year: '2026' }
const badge = (date = '') => ({
  month: date.match(/January|February|March|April|May|June|July|August|September|October|November|December/)?.[0].slice(0, 3).toUpperCase(),
  year: date.match(/\d{4}/)?.[0],
});

const toEvent = (t, kind) => ({
  kind,
  title: t.title,
  date: t.date,
  venue: t.venue,
  people: t.authors,
  detail: t.role ?? t.note,
  url: t.url,
  urlLabel: t.urlLabel ?? 'View',
  image: asset(t.image ?? t.thumb) ?? cover(t.cover),
  photo: (t.image ?? t.thumb)?.endsWith('.jpg'),
  credit: t.credit ?? (t.cover && posts[t.cover] ? `Image: ${coverCredit(posts[t.cover])}` : undefined),
});

const sections = [
  { id: 'talks', title: 'Talks & presentations', events: talks.map((t) => toEvent(t, 'talk')) },
  { id: 'teaching', title: 'Teaching & workshops', events: teaching.map((t) => toEvent(t, 'workshop')) },
];
---

<Layout
  title="Talks | Aakash Tripathi"
  description="Talks and posters by Aakash Tripathi (Stanford MedAI, NVIDIA GTC, USCAP), his SIIM 2026 learning lab, and workshops he assisted at the Mayo Clinic AI Summit and NVIDIA Deep Learning Institute."
>
  <PageIntro title="Talks, posters & workshops">
    <p>
      Presentations of our work at research meetings, and the hands-on workshops I have taught or helped teach, from NVIDIA
      Deep Learning Institute courses to a SIIM learning lab on running local LLMs behind institutional firewalls.
    </p>
  </PageIntro>

  {
    sections.map((s, i) => (
      <>
        {i > 0 && <hr class="rule" />}
        <section class="container events" id={s.id} aria-labelledby={`${s.id}-title`}>
          <h2 id={`${s.id}-title`}>{s.title}</h2>
          <ul>
            {s.events.map((e) => {
              const b = badge(e.date);
              return (
                <li class="event">
                  <div class:list={['event__media', { 'event__media--photo': e.photo, 'event__media--figure': e.image && !e.photo }]}>
                    {e.image ? (
                      <Image src={e.image} alt="" widths={[400, 640, 900]} sizes="(min-width: 900px) 400px, 100vw" />
                    ) : (
                      <span class="event__placeholder" aria-hidden="true">
                        {s.id === 'talks' ? 'Talk' : 'Workshop'}
                      </span>
                    )}
                    <span class="event__badge" aria-hidden="true">
                      {b.month && <span>{b.month}</span>}
                      <strong>{b.year}</strong>
                    </span>
                  </div>
                  <div class="event__body">
                    <h3>{e.title}</h3>
                    <p class="event__meta">
                      {e.venue}
                      {e.date && <> · {e.date}</>}
                    </p>
                    {e.people && (
                      <p class="event__people">
                        {e.people.split(', ').map((a, j, all) => (
                          <>
                            <span class:list={[{ me: isMe(a) }]}>{a}</span>
                            {j < all.length - 1 && ', '}
                          </>
                        ))}
                      </p>
                    )}
                    {e.detail && <p class="event__detail">{e.detail}</p>}
                    {e.image && e.credit && <p class="event__credit">{e.credit}</p>}
                    {e.url && (
                      <a class="button button--small" href={e.url} target="_blank" rel="noopener noreferrer">
                        {e.urlLabel} &rarr;
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      </>
    ))
  }
</Layout>

<style>
  .events {
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .events > h2 {
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--muted-color);
    margin-bottom: 40px;
  }

  .events ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .event {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: 24px 40px;
    padding-bottom: 48px;
  }

  .event__media {
    position: relative;
    aspect-ratio: 1;
    background: var(--surface-bg);
    overflow: hidden;
  }

  .event__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .event__media--photo :global(img) {
    object-fit: cover;
  }

  .event__media--figure {
    background: #fff;
    padding: 16px;
  }

  .event__media--figure :global(img) {
    object-fit: contain;
  }

  .event__placeholder {
    position: absolute;
    left: 24px;
    bottom: 20px;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--faint-color);
  }

  .event__badge {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 58px;
    padding: 6px 8px;
    background: #f4f4f2;
    color: #000;
    font-size: 0.7rem;
    line-height: 1.3;
  }

  .event__badge strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .event__body {
    padding-top: 4px;
  }

  h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.4;
    margin-bottom: 10px;
  }

  .event__meta,
  .event__people,
  .event__detail {
    font-size: 0.8rem;
    margin: 0 0 6px;
    color: var(--muted-color);
  }

  .event__meta {
    color: var(--text-color);
  }

  .event__credit {
    font-size: 0.7rem;
    color: var(--faint-color);
    margin: 0 0 6px;
  }

  .event .button {
    margin-top: 12px;
  }

  @media (max-width: 760px) {
    .event {
      grid-template-columns: 1fr;
    }

    .event__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
