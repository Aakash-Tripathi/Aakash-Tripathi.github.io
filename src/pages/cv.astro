---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { profile, experience, education, teaching, talks, awards, peerReview, mentoring, memberships, skills, media } from '../data/cv.js';
import { isMe } from '../lib/projects.js';

const sections = [
  ['experience', 'Experience'],
  ['education', 'Education'],
  ['teaching', 'Teaching & workshops'],
  ['talks', 'Talks & presentations'],
  ['honors', 'Honors & awards'],
  ['service', 'Peer review'],
  ['mentoring', 'Mentoring'],
  ['memberships', 'Memberships'],
  ['skills', 'Technical skills'],
  ['media', 'Media'],
];
const SHOWN = 5;
---

<Layout
  title="CV | Aakash Tripathi"
  description="Curriculum vitae of Aakash Tripathi, PhD: research appointments at Moffitt Cancer Center, education, teaching, talks, honors, peer review, mentoring, and technical skills."
>
  <PageIntro title="Curriculum vitae">
    <p>Updated September 29, 2026.</p>
    <p>{profile.summary}</p>
    <p><a class="button" href="/Aakash_Tripathi_CV.pdf" download>Download CV (PDF)</a></p>
  </PageIntro>

  <div class="container cv">
    <nav class="cv__nav" aria-label="CV sections">
      <ol>
        {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        <li><a href="/research/">Publications →</a></li>
      </ol>
    </nav>

    <div class="cv__body">
      <section id="experience">
        <h2>Experience</h2>
        <ol class="timeline">
          {
            experience.map((job) => (
              <li>
                <h3>{job.title}</h3>
                <p class="where">
                  {job.organization}
                  {job.department && <> · {job.department}</>} · {job.location}
                </p>
                <p class="when">
                  {job.start} – {job.end}
                </p>
                {job.note && <p class="muted">{job.note}</p>}
                <ul>
                  {job.bullets.slice(0, SHOWN).map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {job.bullets.length > SHOWN && (
                  <details>
                    <summary>{job.bullets.length - SHOWN} more responsibilities</summary>
                    <ul>
                      {job.bullets.slice(SHOWN).map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section id="education">
        <h2>Education</h2>
        <ol class="timeline">
          {
            education.map((e) => (
              <li>
                <h3>{e.degree}</h3>
                <p class="where">
                  {e.institution} · {e.location}
                </p>
                <p class="when">
                  {e.start} – {e.end}
                </p>
                {e.details.map((d) => (
                  <p>{d}</p>
                ))}
                {e.url && (
                  <p>
                    <a href={e.url} target="_blank" rel="noopener noreferrer">
                      {e.urlLabel}
                    </a>
                  </p>
                )}
              </li>
            ))
          }
        </ol>
        <p class="muted small">June - July 2022: transition between degree programs following B.S. completion and before Ph.D. enrollment.</p>
      </section>

      <section id="teaching">
        <h2>Teaching & workshops</h2>
        <ul class="entries">
          {
            teaching.map((t) => (
              <li>
                <p class="when">{t.date}</p>
                <h3>{t.title}</h3>
                <p class="where">{t.venue}</p>
                <p>{t.role}</p>
                {t.url && (
                  <p>
                    <a href={t.url} target="_blank" rel="noopener noreferrer">
                      {t.urlLabel}
                    </a>
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="talks">
        <h2>Talks & presentations</h2>
        <ul class="entries">
          {
            talks.map((t) => (
              <li>
                <p class="when">{t.date}</p>
                <h3>{t.title}</h3>
                <p class="where">
                  {t.authors.split(', ').map((a, i, all) => (
                    <>
                      <span class:list={[{ me: isMe(a) }]}>{a}</span>
                      {i < all.length - 1 && ', '}
                    </>
                  ))}
                  . <em>{t.venue}</em>
                  {t.note && <>. {t.note}</>}
                </p>
                {t.url && (
                  <p>
                    <a href={t.url} target="_blank" rel="noopener noreferrer">
                      {t.urlLabel}
                    </a>
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="honors">
        <h2>Honors & awards</h2>
        <ul class="entries">
          {
            awards.map((a) => (
              <li>
                <p class="when">{a.date}</p>
                <h3>{a.title}</h3>
                <p class="where">{a.venue}</p>
                {a.detail && <p>{a.detail}</p>}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="service">
        <h2>Peer review</h2>
        <p class="when">Journal reviewer, {peerReview.period}</p>
        <ul class="tag-list">
          {peerReview.journals.map((j) => <li class="tag">{j}</li>)}
        </ul>
      </section>

      <section id="mentoring">
        <h2>Mentoring</h2>
        <p class="muted">Research collaboration with students and trainees.</p>
        <ul class="entries entries--compact">
          {
            mentoring.map((m) => (
              <li>
                <h3>{m.name}</h3>
                <p class="where">
                  {m.affiliation} · {m.period}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="memberships">
        <h2>Memberships</h2>
        <ul class="entries entries--compact">
          {
            memberships.map((m) => (
              <li>
                <h3>{m.name}</h3>
                <p class="where">
                  {m.role}
                  {m.period && <> · {m.period}</>}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="skills">
        <h2>Technical skills</h2>
        <dl class="skills">
          {
            skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>
                  <ul class="tag-list">
                    {s.items.map((i) => (
                      <li class="tag">{i}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="media">
        <h2>Media coverage & acknowledgments</h2>
        <ul class="entries">
          {
            media.map((m) => (
              <li>
                <p class="when">{m.date}</p>
                <h3>
                  <a href={m.url} target="_blank" rel="noopener noreferrer">
                    {m.title}
                  </a>
                </h3>
                <p class="where">
                  {m.byline && <>{m.byline} </>}
                  <em>{m.outlet}</em>
                </p>
                <p>{m.detail}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  .cv {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 56px;
    padding-top: 72px;
    padding-bottom: 40px;
  }

  .cv__nav {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    align-self: start;
    font-size: 0.9rem;
  }

  .cv__nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border-color);
  }

  .cv__nav a {
    display: block;
    padding: 4px 0 4px 14px;
    color: var(--muted-color);
    font-weight: 600;
  }

  .cv__nav a:hover {
    color: var(--primary);
  }

  .cv__body section {
    padding-bottom: 40px;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }

  .cv__body section + section {
    padding-top: 36px;
    border-top: 1px solid var(--border-color);
  }

  .cv__body h2 {
    font-size: 1.45rem;
    margin-bottom: 20px;
  }

  .cv__body h3 {
    font-size: 1.05rem;
    margin: 0 0 2px;
    line-height: 1.35;
  }

  .cv__body p {
    margin: 0 0 6px;
  }

  .where {
    color: var(--muted-color);
    font-size: 0.95rem;
  }

  .when {
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--muted-color);
    text-transform: uppercase;
  }

  .small {
    font-size: 0.88rem;
  }

  .timeline {
    list-style: none;
    margin: 0 0 16px;
    padding: 0 0 0 22px;
    border-left: 2px solid var(--border-color);
  }

  .timeline > li {
    position: relative;
    padding-bottom: 28px;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--page-bg);
    border: 2px solid #fff;
  }

  .timeline ul {
    margin: 10px 0 0;
    padding-left: 1.2em;
    font-size: 0.97rem;
  }

  .timeline li li {
    margin-bottom: 4px;
  }

  details {
    margin-top: 6px;
    font-size: 0.97rem;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.92rem;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries > li {
    padding: 14px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .entries > li:first-child {
    padding-top: 0;
  }

  .entries--compact > li {
    padding: 10px 0;
  }

  .skills {
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .skills dt {
    font-weight: 700;
    color: var(--heading-color);
  }

  .skills dd {
    margin: 0;
  }

  @media (max-width: 820px) {
    .cv {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .cv__nav {
      position: static;
      margin-bottom: 24px;
    }

    .cv__nav ol {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 0;
      border-left: 0;
    }

    .cv__nav a {
      padding: 2px 14px 2px 0;
    }

    .skills div {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
