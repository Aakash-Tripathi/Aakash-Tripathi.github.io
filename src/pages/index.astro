---
import Layout from '../layouts/Layout.astro';
import StructuredData from '../components/StructuredData.astro';
import Carousel from '../components/Carousel.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile, links, news, education, awards, talks, teaching, gallery } from '../data/cv.js';
import { getProjects, formatDate, coverCredit } from '../lib/projects.js';
import { asset, cover } from '../lib/images.js';
import { fetchCitationCount } from '../utils/googleScholar.js';

const posts = await getProjects();
const citations = await fetchCitationCount();

// Carousel: talk and poster images first, then the lead figure of each blog post.
const talkSlides = [...talks, ...teaching]
  .filter((t) => asset(t.image))
  .map((t) => ({
    image: asset(t.image),
    alt: t.alt ?? `${t.title}, ${t.venue}`,
    caption: `${t.title} · ${t.venue}${t.date ? `, ${t.date}` : ''}${t.credit ? ` (${t.credit})` : ''}`,
    href: t.url,
    fit: t.image.endsWith('.jpg') ? ('cover' as const) : ('contain' as const),
  }))
  .concat(gallery.filter((g) => asset(g.image)).map((g) => ({ ...g, image: asset(g.image), fit: 'contain' as const })));
const postSlides = posts
  .filter((p) => cover(p.slug))
  .map((p) => ({
    image: cover(p.slug),
    alt: p.coverAlt ?? `Figure from ${p.paperTitle ?? p.title}`,
    caption: `${p.title.startsWith(p.short) ? p.title : `${p.short}: ${p.title}`}${coverCredit(p) ? `. ${coverCredit(p)}` : ''}`,
    href: p.url,
    fit: 'contain' as const,
  }));
const slides = talkSlides.flatMap((s, i) => [s, ...postSlides.slice(i * 2, i * 2 + 2)]).concat(postSlides.slice(talkSlides.length * 2));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://aakash-tripathi.github.io/#person',
  name: profile.name,
  givenName: 'Aakash',
  familyName: 'Tripathi',
  honorificSuffix: 'Ph.D.',
  jobTitle: `${profile.role} - ${profile.focus}`,
  description: profile.summary,
  url: 'https://aakash-tripathi.github.io',
  image: 'https://aakash-tripathi.github.io/assets/profile-photo.jpg',
  email: profile.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Tampa', addressRegion: 'FL', addressCountry: 'US' },
  worksFor: { '@type': 'Organization', name: profile.organization, url: profile.organizationUrl },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.institution })),
  award: awards.map((a) => `${a.title} - ${a.venue} (${a.date})`),
  knowsAbout: [
    'Multimodal representation learning',
    'Foundation models',
    'Large language models',
    'Survival analysis',
    'Clinical natural language processing',
    'Computational pathology',
    'Precision oncology',
  ],
  sameAs: [links.scholar, links.orcid, links.github, links.huggingface, links.linkedin, links.researchgate],
};
---

<Layout title="Aakash Tripathi, PhD | AI for Precision Oncology">
  <StructuredData data={personSchema} />

  <section class="container hero">
    <h1>Hello! I am Aakash, an AI research scientist working in precision oncology.</h1>
    <img class="hero__photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="800" height="800" />
  </section>

  {slides.length > 0 && <Carousel slides={slides} label="Talks, posters and paper figures" />}

  <hr class="rule" />
  <section class="container home-split">
    <div>
      <h2>Recent news</h2>
      <ol class="news">
        {
          news.slice(0, 7).map((n) => (
            <li>
              <time datetime={n.date}>{formatDate(n.date)}</time>
              <span>
                {n.href ? (
                  <a href={n.href} {...(n.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {n.text}
                  </a>
                ) : (
                  n.text
                )}
              </span>
            </li>
          ))
        }
      </ol>
      {citations && <p class="citations">{citations.toLocaleString('en-US')} citations on <a href={links.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a></p>}
    </div>
    <div>
      <h2>From the blog</h2>
      <div class="home-posts">
        {posts.slice(0, 2).map((p) => <BlogCard post={p} excerpt={false} />)}
      </div>
      <p class="more"><a class="button button--ghost" href="/blog/">All posts</a></p>
    </div>
  </section>

</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding-top: 56px;
    padding-bottom: 72px;
  }

  h1 {
    font-size: clamp(2.3rem, 4.6vw, 4rem);
    line-height: 1.25;
    text-align: center;
    margin: 0;
    padding: 0 4%;
  }

  .hero__photo {
    justify-self: center;
    width: min(100%, 400px);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__photo {
      order: -1;
      width: min(70%, 320px);
    }
  }

  .home-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 72px;
    padding-top: 88px;
    padding-bottom: 104px;
  }

  .home-split h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.2rem);
    margin-bottom: 28px;
  }

  @media (max-width: 900px) {
    .home-split {
      grid-template-columns: 1fr;
    }
  }

  .news {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news li {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 18px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.92rem;
  }

  .news li:first-child {
    padding-top: 0;
  }

  .news time {
    font-size: 0.8rem;
    color: var(--muted-color);
    padding-top: 2px;
  }

  .news a {
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }

  .citations {
    margin-top: 28px;
    font-size: 0.86rem;
    color: var(--muted-color);
  }

  .home-posts :global(h3) {
    font-size: 1.2rem;
  }

  .home-posts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  @media (max-width: 560px) {
    .home-posts {
      grid-template-columns: 1fr;
    }
  }

  .more {
    margin-top: 36px;
    text-align: center;
  }

</style>
